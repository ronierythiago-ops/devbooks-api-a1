{
  "info": {
    "_postman_id": "9f1f4c3a-0f1e-4a56-b2e2-4f0c9a7c2d11",
    "name": "DevBooks API - A1",
    "description": "Coleção de testes da Atividade Prática Avaliativa A1 - Programação para WEB II.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authorId",
      "value": "COLE_O_ID_DO_AUTOR_AQUI"
    },
    {
      "key": "bookId",
      "value": "COLE_O_ID_DO_LIVRO_AQUI"
    }
  ],
  "item": [
    {
      "name": "1 - Criar Autor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Machado de Assis\",\n  \"biography\": \"Escritor brasileiro, autor de obras como Dom Casmurro e Memórias Póstumas de Brás Cubas.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/authors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "authors"
          ]
        }
      }
    },
    {
      "name": "2 - Criar Livro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dom Casmurro\",\n  \"release_year\": 1899,\n  \"author_id\": \"{{authorId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "3 - Listar Livros com Autores",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "4 - Atualizar Livro",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dom Casmurro - Edição Revisada\",\n  \"release_year\": 1899,\n  \"author_id\": \"{{authorId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        }
      }
    },
    {
      "name": "5 - Excluir Livro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        }
      }
    }
  ]
}
